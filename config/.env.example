# JARVIS-X — copy to .env and fill in. Never commit real keys.
# Existing installs without .env keep using config/api_keys.json.

# AI provider: gemini | openai_compatible
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=models/gemini-3.1-flash-live-preview
AI_FALLBACK_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_S=30
AI_MAX_RETRIES=2

# Optional local model (offline degraded mode, not mandatory)
LOCAL_MODEL_ENABLED=0
